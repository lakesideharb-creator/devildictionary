{
  "appId": "com.devildictionary.app",
  "appName": "The Devil's Dictionary",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#17120e",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#17120e",
      "overlaysWebView": false
    }
  },
  "ios": {
    "contentInset": "always",
    "scheme": "TheDevilsDictionary",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  }
}
